let currentFilter='all';
let selected=[];

function allowed(){
const [d,p,n]=document.getElementById('plan').value.split('|').map(Number);
const people=Number(document.getElementById('persons').value);
return n*people;
}

function renderTours(){
const g=document.getElementById('tourGrid');
g.innerHTML='';
const list=currentFilter==='all'?tours:tours.filter(x=>x[0]===currentFilter);

list.forEach((t)=>{
const i=tours.indexOf(t);
const a=document.createElement('div');
a.className='tour-card';
a.innerHTML=`<img src="${t[3]}" alt="${t[1]}" loading="lazy"><div class="tour-card-body"><small>${t[0]}</small><h3>${t[1]}</h3><p>${t[2]}</p><button class="btn ${selected.includes(i)?'green':''}" onclick="toggleTour(${i})">${selected.includes(i)?'✓ Selected':'Select This Site'}</button></div>`;
g.appendChild(a);
});

document.getElementById('allowedCount').textContent=allowed();
document.getElementById('selectedCount').textContent=selected.length;
document.getElementById('sites').value=selected.map(i=>tours[i][1]).join('\n');
}

function toggleTour(i){
const max=allowed();
if(selected.includes(i)){
selected=selected.filter(x=>x!==i);
}else{
if(selected.length>=max){
alert('Your current booking allows '+max+' complimentary tour site(s).');
return;
}
selected.push(i);
}
renderTours();
}

function filterTours(f,b){
currentFilter=f;
document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));
b.classList.add('active');
renderTours();
}

function updateCalc(){
const [d,p,n]=document.getElementById('plan').value.split('|').map(Number);
const people=Number(document.getElementById('persons').value);
const rates={1:0,2:.10,3:.15,4:.20,5:.25};
const base=p*people;
const disc=base*rates[people];

document.getElementById('baseTotal').textContent='₹'+base.toLocaleString('en-IN');
document.getElementById('discount').textContent='− ₹'+disc.toLocaleString('en-IN');
document.getElementById('grandTotal').textContent='₹'+(base-disc).toLocaleString('en-IN');
document.getElementById('tourAllowance').textContent=n*people;

while(selected.length>n*people)selected.pop();
renderTours();
}

function goBooking(){
document.getElementById('booking').scrollIntoView({behavior:'smooth'});
}

function sendBooking(e){
e.preventDefault();

const [d,p,n]=document.getElementById('plan').value.split('|').map(Number);
const people=Number(document.getElementById('persons').value);
const rates={1:0,2:.10,3:.15,4:.20,5:.25};
const total=p*people*(1-rates[people]);

const msg=`Hello SKILLED VIHARI FARMSTAY,

FARMSTAY BOOKING REQUEST
Name: ${document.getElementById('name').value}
Mobile: ${document.getElementById('phone').value}
Plan: ${document.getElementById('plan').selectedOptions[0].text}
Persons: ${people}
Check-in: ${document.getElementById('date').value}
Check-out: ${document.getElementById('checkout').value}
Selected free-tour sites (${selected.length}/${n*people}):
${selected.map(i=>'- '+tours[i][1]+' ('+tours[i][0]+')').join('\n')||'- To be selected'}
Indicative farmstay total after group discount: ₹${total.toLocaleString('en-IN')}
Additional request: ${document.getElementById('message').value}

Please confirm availability, routing, driver-guide vehicle, fuel charges and any other applicable charges.`;

window.open('https://wa.me/917762918733?text='+encodeURIComponent(msg),'_blank');
}

renderTours();
updateCalc();
</script>

